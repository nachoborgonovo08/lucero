# --- Obligatorias ---
# Postgres (Supabase: usar la cadena "Transaction pooler", puerto 6543)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lucero
# URL pública del sitio, sin barra final
APP_URL=http://localhost:3000

# --- Planes (moneda local de tu cuenta de Mercado Pago) ---
# Ajustá estos montos al tipo de cambio: objetivo ~USD 15 y ~USD 29.
CURRENCY=ARS
PRICE_ESENCIAL=19900
PRICE_PRO=39900
PRICE_AGENCIA=129900

# --- Cobro por transferencia (opcional; se puede usar sin Mercado Pago) ---
# Alias de la cuenta que recibe (tiene que ser de una persona mayor de edad),
# titular que se muestra al cliente y WhatsApp donde te mandan el comprobante.
TRANSFER_ALIAS=
TRANSFER_HOLDER=
TRANSFER_WHATSAPP=

# --- Mercado Pago (Tus integraciones > Credenciales / Webhooks) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- IA para responder reseñas (console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Opcional: modelo. Por defecto claude-opus-5-5.
AI_MODEL=

# --- Emails transaccionales (resend.com). Sin esto no se envían emails. ---
RESEND_API_KEY=
EMAIL_FROM=Lucero <hola@tudominio.com>

# --- Operación ---
# Emails con acceso a /admin, separados por coma
ADMIN_EMAILS=
# Secreto para el cron diario (Vercel lo envía como Authorization: Bearer)
CRON_SECRET=
